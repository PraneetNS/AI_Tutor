# ==============================================================================
# AI Tutor Service - Environment Configuration (.env.example)
#
# IMPORTANT:
# - Copy this file to '.env' and populate with your own development values.
# - '.env' is gitignored to protect sensitive credentials from being committed.
# - API keys and secrets are loaded ONLY from environment variables (no hardcoded defaults).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider API Keys & Secrets (Loaded from environment only - never real keys here)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# ------------------------------------------------------------------------------
# 2. Model Gateway & Provider Strategy
# ------------------------------------------------------------------------------
# Provider options: mock, gpt/openai, claude/anthropic, gemini/google, qwen
PRIMARY_PROVIDER=mock
FALLBACK_PROVIDER=mock

# Model Overrides
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
GEMINI_MODEL=gemini-2.0-flash
QWEN_MODEL=qwen-plus
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ------------------------------------------------------------------------------
# 3. Database & Cache Configuration
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://tutor_user:tutor_password@localhost:5432/ai_tutor
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 4. Server & Service Configuration
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# ------------------------------------------------------------------------------
# 5. External Call Timeouts (Seconds)
# ------------------------------------------------------------------------------
MODEL_REQUEST_TIMEOUT=15.0
DB_TIMEOUT=5.0
REDIS_TIMEOUT=3.0

# ------------------------------------------------------------------------------
# 6. Pedagogical Defaults & Thresholds
# ------------------------------------------------------------------------------
DEFAULT_HINT_BUDGET=3
QUIZ_MASTERY_THRESHOLD=0.80
CHALLENGE_MASTERY_THRESHOLD=0.90
EXPLAIN_FAILURE_THRESHOLD=2
